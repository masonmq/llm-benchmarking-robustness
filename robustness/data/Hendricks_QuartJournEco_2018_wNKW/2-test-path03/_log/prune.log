    "edyrs",
    "yearLastHomeJob",
    "yearLastUsJob",
    "sex",
    "yrborn",
    "lastHomeWageAdjusted",
    "lastUsWageAdjusted",
    "country",
]


def make_education_group(edyrs: pd.Series) -> pd.Series:
    """Map years of schooling to the education groups described in the paper."""
    conditions = [
        edyrs <= 8,
        (edyrs >= 9) & (edyrs <= 11),
        edyrs == 12,
        (edyrs >= 13) & (edyrs <= 15),
        edyrs >= 16,
    ]
    choices = [
        "no_high_school",
        "some_high_school",
        "high_school",
        "some_college",
        "college_degree",
    ]
    out = np.select(conditions, choices, default=pd.NA)
    cat = pd.Categorical(
        out,
        categories=[
            "college_degree",
            "no_high_school",
            "some_high_school",
            "high_school",
            "some_college",
        ],
    )
    return pd.Series(cat, index=edyrs.index, name="edu_group")


