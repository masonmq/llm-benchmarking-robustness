        "rows": int(len(df)),
        "removed": int(before - len(df)),
        "columns": REQUIRED_COLUMNS,
    })

    before = len(df)
    df = df[(df["lastHomeWageAdjusted"] > 0) & (df["lastUsWageAdjusted"] > 0)].copy()

