    missing_cols = [c for c in REQUIRED_COLUMNS if c not in df0.columns]
    if missing_cols:
        raise ValueError(f"Missing required columns: {missing_cols}")

    df = df0.copy()

    before = len(df)
    df = df.dropna(subset=REQUIRED_COLUMNS)
    sample_flow.append({
