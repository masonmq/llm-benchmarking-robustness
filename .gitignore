# .spyproject
.spyproject/

# ReplicatorBench gitignores
replicatorbench/data/*
replicatorbench/data/original/
replicatorbench/data/original/**
**/replication_data/** 
**/_logs/**
**/_runtime/**
**/_artifacts/**
**/.DS_Store

replicatorbench/.env
**/__pycache__/**
agent_process.log
info_extractor/__pycache__/
test_data/
.coverage

# Ignore Virtual Environment
env/

# ReplicatorBench additional ignores
replicatorbench/info_extractor/__pycache__/
replicatorbench/test_data/
replicatorbench/.coverage

# Robustness gitignore
robustness/.env
robustness/**/__pycache__/**
robustness/.coverage
# Study data stays out of git; only the analysis/report scripts under data/annotators are tracked.
robustness/data/*
!robustness/data/annotators/
robustness/data/annotators/*
!robustness/data/annotators/*.py
!robustness/data/annotators/code_pilot/
robustness/data/annotators/code_pilot/*
!robustness/data/annotators/code_pilot/*.py
!robustness/data/annotators/code_pilot/pilot_instructions.md
robustness/eval/

# Secrets and personal data
/.env
**/*Screening*.csv
robustness/annotation_app/deployment/cloudflare/wrangler.toml
robustness/annotation_app/TEST_ANNOTATOR_INSTRUCTIONS.md
